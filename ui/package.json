{
  "name": "novapay-feature-store-console",
  "private": true,
  "version": "0.1.0",
  "description": "NovaPay Feature Store Console — frontend mockup (mock data only, no BFF yet)",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n web,bff -c blue,green \"vite\" \"tsx watch server/index.ts\"",
    "web": "vite",
    "mock": "VITE_DEFAULT_MODE=mock vite",
    "server": "tsx watch server/index.ts",
    "vmc": "VOLTDB_SERVER_CONFIG=./vmc-server.yaml ${VMC_HOME:-$HOME/Downloads/voltdb-vmc-14.2.0}/bin/vmc",
    "gateway": "./gateway/run.sh",
    "start": "tsx server/index.ts",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p server/tsconfig.json"
  },
  "dependencies": {
    "@codemirror/lang-sql": "^6.8.0",
    "@uiw/react-codemirror": "^4.23.0",
    "fastify": "^4.29.1",
    "kafkajs": "^2.2.4",
    "lucide-react": "^0.441.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2",
    "recharts": "^2.12.7"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^8.2.2",
    "tsx": "^4.23.13",
    "typescript": "^5.5.4",
    "vite": "^5.4.8"
  },
  "engines": {
    "node": ">=20 <21"
  }
}
