# ===========================================================================
# NovaPay Real-Time Feature Store — single edit-once configuration.
#
#   cp settings.env.example settings.env      # then edit settings.env
#
# Every script in ./scripts sources scripts/00_env.sh, which loads this file.
# Switching topology only changes the ENDPOINTS below — nothing else.
#
#   Laptop / single VM ...... leave the localhost defaults.
#   One VM per component .... set KAFKA_BOOTSTRAP / VOLTDB_SERVERS to each
#                             VM's reachable (internal) address.
#   Kafka / VoltDB cluster .. set KAFKA_BOOTSTRAP to a broker list, raise
#                             REPLICATION_FACTOR, and point VOLTDB_CONFIG at a
#                             multi-host deployment.xml (see docs/DEPLOYMENT.md).
# ===========================================================================

# ---- product kits (where you unpacked each download) ----------------------
KAFKA_HOME="$HOME/kafka_2.13-3.7.0"
VOLTDB_HOME="$HOME/voltdb-ent-14.0.1"
VOLTSP_HOME="$HOME/voltsp-1.7.1"

# ---- licenses (Enterprise trial from Volt Active Data — see README) --------
# VOLTDB_LICENSE is optional (recent kits bundle one); VOLTSP_LICENSE is required.
VOLTDB_LICENSE="$VOLTDB_HOME/license.xml"
VOLTSP_LICENSE="$VOLTSP_HOME/license.xml"

# ---- endpoints (the ONLY thing that changes between topologies) ------------
KAFKA_BOOTSTRAP="localhost:9092"
VOLTDB_SERVERS="localhost:21212"

# ---- optional: VoltDB deployment config (sites-per-host, k-factor, cluster) -
# Leave empty for a single node with kit defaults. Point at a deployment.xml
# to set sitesperhost or a multi-host cluster (deploy/voltdb-cluster-deployment.xml).
VOLTDB_CONFIG=""

# ---- topics & scale knobs --------------------------------------------------
TOPIC_EVENTS="novapay-txn-events"
TOPIC_DLQ="novapay-txn-dlq"
CONSUMER_GROUP="novapay-feature-agg"
SOURCE_PARTITIONS="50"
DLQ_PARTITIONS="4"
REPLICATION_FACTOR="1"          # raise to 3 on a multi-broker Kafka cluster

# ---- run defaults (overridable as positional args to 05 / 06) --------------
DEFAULT_EPS="2000"
DEFAULT_CUSTOMERS="10000000"
DEFAULT_QPS="500"
